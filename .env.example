# API base URL. In development the Vite proxy forwards /api to localhost:8080.
VITE_API_BASE_URL=/api/v1

# EdgeOne Pages production example:
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Tencent Captcha mode: 1.0 uses TCaptcha.js, 2.0 uses TJCaptcha.js
VITE_CAPTCHA_MODE=1.0
# Tencent Captcha web app id (required in production)
VITE_CAPTCHA_APP_ID=
# Set to false only for local development; production defaults to true
VITE_CAPTCHA_ENABLED=false
